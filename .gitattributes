# 统一换行符，避免 Windows / macOS / Linux 协作时整文件 diff
* text=auto eol=lf

# Windows 专有脚本保持 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# 二进制资源：禁止换行符转换与文本 diff
*.xlsx    binary
*.xls     binary
*.docx    binary
*.pkl     binary
*.parquet binary
*.sqlite  binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.ico     binary
*.woff    binary
*.woff2   binary
