# =====================================================================
#  .gitignore · 抖音微短剧热度预测与影响因素分析
# ---------------------------------------------------------------------
#  取舍原则：
#    跟踪 —— 源码、配置、文档，以及「体积小且不可再生」的关键产物
#            （如原始数据源表、建模数据集、部署模型 JSON、论文）。
#    忽略 —— 大体量中间数据、模型二进制、生成的图表与数据库，
#            它们都能由 src/ 下的流水线重新产出，不该占用仓库体积。
# =====================================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# ---------- 本地环境与密钥 ----------
.env
.env.*
!.env.example
*.local

# ---------- 编辑器 / 操作系统 ----------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---------- 原始爬取数据（体量大，可由爬虫再生）----------
data/raw/

# ---------- 中间格式（parquet 可由 csv / 流水线再生）----------
data/processed/*.parquet

# ---------- 可再生的模型与数据产物 ----------
outputs/*.sqlite
outputs/*.db
outputs/models/
outputs/figures/
outputs/*.xlsx
outputs/dashboard/echarts.min.js

# ---------- 流水线中间目录与历史归档 ----------
output/
_archive_simulated/

# ---------- 工具链元数据（含本地记忆，不入库）----------
.workbuddy/
